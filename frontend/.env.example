# Backend address for the /api proxy (read at build/dev start).
API_URL=http://localhost:4000
# Customer sign-in with Clerk. Leave both empty to sign in to the admin with the backend's ADMIN_TOKEN instead.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# The landing page's live demo chats with this chatbot (its slug, shown under its name in the dashboard switcher).
# Its handoff tickets then land in that chatbot's Handoff inbox. Empty: footnote-bd0daa (set in components/landing.tsx);
# "default" for the built-in sample store.
NEXT_PUBLIC_DEMO_KB=
