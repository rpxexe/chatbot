{
  "name": "chatbot-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "import-faqs": "tsx --env-file-if-exists=.env src/import-faqs.ts",
    "test": "tsx --env-file-if-exists=.env --test test/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@clerk/express": "^2.1.96",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "node-html-parser": "^9.0.7",
    "pg": "^8.23.1",
    "stemmer": "^2.0.1",
    "unpdf": "^2.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
