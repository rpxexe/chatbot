DATABASE_URL=postgres://chatbot:chatbot@localhost:5432/chatbot
PORT=4000
# Platform operator key for scripts and support. Acts as tenant "admin", or the tenant in the X-Tenant-Id header.
# Use a long random string, e.g. `node -e "console.log(crypto.randomBytes(24).toString('hex'))"`
ADMIN_TOKEN=
# Customer sign-in (https://dashboard.clerk.com → API keys). Set both here, and the publishable key in the frontend.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Public URL of the frontend. Its origin may always use every chatbot (widget page, admin preview).
APP_URL=http://localhost:3000
# Original uploads in S3-compatible storage. Leave S3_BUCKET empty to not keep originals.
# These values match the dev storage in docker-compose.yml. For AWS S3, drop S3_ENDPOINT and set S3_REGION.
S3_BUCKET=chatbot
S3_ENDPOINT=http://localhost:8333
AWS_ACCESS_KEY_ID=chatbot
AWS_SECRET_ACCESS_KEY=chatbot-dev-secret
# Email through Resend (https://resend.com/api-keys): the team hears about new tickets at the Handoff email, and
# "Get a reply by email" visitors get agent replies. Empty: no emails. RESEND_FROM must be on a domain verified in Resend;
# the default onboarding@resend.dev only delivers to your own Resend account's address.
RESEND_API_KEY=
RESEND_FROM=Footnote <onboarding@resend.dev>
# Email replies into the dashboard thread (optional). Visitors reply to reply+<ticket>@RESEND_INBOUND_DOMAIN:
# use your Resend receiving address domain (Emails > Receiving, e.g. abc123.resend.app) or a custom domain with
# receiving on. Then Resend > Webhooks: add <public backend URL>/api/inbound/resend for `email.received`, and paste
# its signing secret below. Resend must reach that URL, so localhost needs a tunnel (e.g. ngrok).
RESEND_INBOUND_DOMAIN=
RESEND_WEBHOOK_SECRET=
